{
  "name": "pathfinder",
  "version": "0.1.0",
  "private": true,
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "scripts": {
    "build": "npm run build:wasm && npx next build",
    "build:wasm": "cd pathfinder && PATH=$HOME/.cargo/bin:$PATH wasm-pack build --target web --out-dir pkg",
    "dev": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1",
    "@radix-ui/react-icons": "^1.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slider": "^1.1",
    "@radix-ui/react-slot": "^1.1",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/turf": "^7.1",
    "chart.js": "^4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1",
    "cmdk": "^1.0.4",
    "file-saver": "^2.0.5",
    "georaster": "^1.6.0",
    "leaflet": "^1.9",
    "lucide-react": "^0.453",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3",
    "react-dom": "^19.2.5",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^1.7",
    "tailwind-merge": "^2.5",
    "togpx": "^0.5.4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4",
    "tailwindcss-animate": "^1.0",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}
